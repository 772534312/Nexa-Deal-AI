{
  "name": "nexa-deal-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {"node": ">=20 <25", "npm": ">=9"},
  "scripts": {
    "dev": "tsx server.ts",
    "prebuild": "node scripts/harden-server.mjs && node scripts/secure-auth.mjs && node scripts/ensure-auth-import.mjs && node scripts/fix-auth-routes.mjs && node scripts/harden-deal-security-v2.mjs && node scripts/sanitize-production-data.mjs && node scripts/wire-auth-ui.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx server/test/test_suite.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
